# Copy to .env (never commit it). On the server, keep it beside the binary with chmod 600.
TD_ENV=dev
TD_ADDR=127.0.0.1:8090
TD_DATABASE_URL=postgres://td_dev:CHANGE_ME@10.0.0.2:5432/terrandominion_dev?sslmode=disable
# openssl rand -base64 48
TD_JWT_SECRET=CHANGE_ME_TO_48_RANDOM_BYTES_BASE64
# openssl rand -base64 24   (never change once players exist)
TD_DEVICE_PEPPER=CHANGE_ME
TD_GOOGLE_CLIENT_IDS=
TD_APPLE_BUNDLE_IDS=com.hisstudios.terrandominion
TD_TRUST_PROXY=true
TD_DEV_LOGIN=true

# Profile share links (docs/profile-plan.md). The public address of this server, and the store pages
# the profile web page links to (leave empty until the game is in that store).
TD_PUBLIC_URL=https://td-dev.demonreeper.xyz
TD_PLAY_URL=
TD_APPSTORE_URL=
# Opening share links in the app: the SHA-256 of every Android signing key in use (comma-separated,
# colons or not), and the iOS app ids as <team id>.<bundle id>. Public values.
TD_ANDROID_PACKAGE=com.hisstudios.terrandominion
TD_ANDROID_CERT_SHA256=
TD_APPLE_APP_IDS=J2P3QBTV3J.com.hisstudios.terrandominion

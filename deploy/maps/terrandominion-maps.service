[Unit]
Description=Terran Dominion map tiles (TileServer GL)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/terrandominion-maps
# Rendering needs an OpenGL context; xvfb-run gives the headless server one.
ExecStart=/usr/bin/xvfb-run -a tileserver-gl --config /home/ubuntu/terrandominion-maps/config.json --bind 127.0.0.1 --port 8095
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

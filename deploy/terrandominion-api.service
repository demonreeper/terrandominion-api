[Unit]
Description=Terran Dominion API (live)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/terrandominion-api
EnvironmentFile=/home/ubuntu/terrandominion-api/.env
ExecStart=/home/ubuntu/terrandominion-api/tdapi serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
